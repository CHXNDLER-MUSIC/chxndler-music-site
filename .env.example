# Copy this file to .env.local for local development
# Next.js automatically loads .env.local on the server side

# OpenAI API key used by test.mjs and any server code
OPENAI_API_KEY=your_openai_api_key_here

# Optional: override the Google Apps Script webhook used by /api/join
# If unset, the code falls back to the baked-in default.
# Example:
# JOIN_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbw9g8a-jE-50HtsTQTSl22eSTxBWoho57p89C4IKdKZb9p1tTFJPFEx9w3anyvUYDoX5Q/exec
# Enable verbose media debugging logs in the browser console
# Set to "1" to enable, leave unset/empty to disable
NEXT_PUBLIC_MEDIA_DEBUG=

# Supabase (optional)
# If you set the URL and ANON key, the health endpoint will probe Supabase.
# By default this probe is non-critical and won't degrade overall status.
# Set to "true" to make Supabase failures degrade the overall health.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
HEALTH_SUPABASE_CRITICAL=false

# SMTP Email Configuration (for order confirmations)
# Configure these to send order confirmation emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@chxndler.world

# YouTube Live (server-side)
# Provide either the channel ID (UC...) OR the channel handle (e.g., @chxndlerthealien)
# The API will resolve the ID automatically when a handle is provided.
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=UCza6n_vQKltu04G8-UMxMig
YOUTUBE_CHANNEL_HANDLE=

# YouTube Live (client-side fallbacks)
# When you toggle the Go Live override, the site can still show an embed even if
# a live videoId wasn't detected. Set the public channel ID so the override uses
# the channel live embed URL. Optionally set a fallback video ID (used if channel
# ID is not provided).
NEXT_PUBLIC_YOUTUBE_CHANNEL_ID=
